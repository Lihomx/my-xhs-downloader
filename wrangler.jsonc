{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-xhs-downloader",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "XHS_PARSE_FALLBACK_ORIGIN": "https://xhs-images-video-vercel-downloader.vercel.app"
  },
  "assets": {
    "directory": "dist-web",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/admin*"]
  },
  "services": [
    { "binding": "PYTHON_API", "service": "brclio-xhs-python" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNT_RUNTIME", "class_name": "AccountRuntime" },
      { "name": "PARSE_RUNTIME", "class_name": "ParseRuntime" }
    ]
  },
  "migrations": [
    { "tag": "account-runtime-v1", "new_sqlite_classes": ["AccountRuntime"] },
    { "tag": "parse-runtime-v1", "new_sqlite_classes": ["ParseRuntime"] }
  ],
  "version_metadata": { "binding": "DEPLOYMENT" },
  "observability": { "enabled": true },
  "build": { "command": "npm run build:web" }
}
