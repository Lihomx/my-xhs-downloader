{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-xhs-downloader",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "XHS_PARSE_FALLBACK_ORIGIN": "https://xhs-images-video-vercel-downloader.vercel.app"
  },
  "assets": {
    "directory": "dist-web",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "xhs-media"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xhs-db",
      "database_id": "fa1445c4-9bc7-4485-9cae-4c8f6daabdb0"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "version_metadata": { "binding": "DEPLOYMENT" },
  "observability": { "enabled": true },
  "build": { "command": "npm run build:web" }
}
